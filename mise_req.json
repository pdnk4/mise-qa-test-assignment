{
  "info": {
    "name": "MISE — Booking API Tests (Complete)",
    "description": "Расширенная тест-коллекция API для бронирования столика. Включает базовые и граничные проверки с автоматическими assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://qa-booking-demo.vercel.app"
    }
  ],
  "item": [
    {
      "name": "01. Успешное бронирование (Позитивный)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Статус-код 200 или 201', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "pm.test('Ответ содержит JSON с подтверждением брони', function () {",
              "    pm.response.to.be.json;",
              "    const res = pm.response.json();",
              "    pm.expect(res).to.be.an('object');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Анна\",\n  \"phone\": \"+79991234567\",\n  \"date\": \"2026-09-20\",\n  \"time\": \"14:00\",\n  \"guests\": 4\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/booking",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "booking"
          ]
        }
      }
    },
    {
      "name": "02. Невалидный телефон (короткий номер)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Ожидается 400 Bad Request при некорректном телефоне', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Сервер не упал с 500 Internal Server Error', function () {",
              "    pm.expect(pm.response.code).to.not.equal(500);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Анна\",\n  \"phone\": \"12345\",\n  \"date\": \"2026-09-20\",\n  \"time\": \"14:00\",\n  \"guests\": 4\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/booking",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "booking"
          ]
        }
      }
    },
    {
